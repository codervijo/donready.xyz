---
interface Props {
  path: string;
  class?: string;
  size?: number;
}
const { path, class: cls = "", size = 24 } = Astro.props;
---
<svg
  class={cls}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={path}
/>
