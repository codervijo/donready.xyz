---
const links = [
  { href: "/scrub-fit-quiz", label: "Fit Quiz" },
  { href: "/compare", label: "Compare" },
  { href: "/best-scrubs", label: "Best Scrubs" },
  { href: "/dress-code-checker", label: "Dress Code Checker" },
];
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-primary text-primary-foreground font-bold">D</span>
      <span class="text-lg font-bold tracking-tight">DonReady</span>
    </a>
    <nav class="hidden md:flex items-center gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "text-sm",
            currentPath === l.href ? "font-semibold text-foreground" : "font-medium text-muted-foreground hover:text-foreground",
          ]}
        >
          {l.label}
        </a>
      ))}
      <a href="/scrub-fit-quiz" class="btn btn-primary py-2 px-4">Start Quiz</a>
    </nav>
    <button
      id="mobile-menu-toggle"
      class="md:hidden p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="menu-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
      <svg class="close-icon h-5 w-5 hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
    </button>
  </div>
  <div id="mobile-menu" class="md:hidden border-t bg-background hidden">
    <div class="container-page py-3 flex flex-col gap-1">
      {links.map((l) => (
        <a href={l.href} class="rounded-md px-3 py-2 text-sm font-medium hover:bg-muted">{l.label}</a>
      ))}
      <a href="/scrub-fit-quiz" class="btn btn-primary mt-2">Start Quiz</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isOpen));
    btn.querySelector(".menu-icon")?.classList.toggle("hidden");
    btn.querySelector(".close-icon")?.classList.toggle("hidden");
  });
</script>
