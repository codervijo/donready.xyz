---
const {
  title = "Not sure what size to buy?",
  description = "Take the DonReady scrub fit quiz to get matched with brands and sizes that fit your body and your dress code.",
  ctaLabel = "Start Fit Quiz",
} = Astro.props;
---
<section class="container-page my-16">
  <div class="rounded-2xl bg-primary text-primary-foreground p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <h2 class="text-2xl md:text-3xl font-bold">{title}</h2>
      <p class="mt-2 max-w-xl text-primary-foreground/80">{description}</p>
    </div>
    <a href="/scrub-fit-quiz" class="btn btn-brand whitespace-nowrap">{ctaLabel}</a>
  </div>
</section>
