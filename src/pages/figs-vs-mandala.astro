---
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import Icon from "../components/Icon.astro";
import { ICONS } from "../lib/icons";

const site = "https://donready.xyz";
const url = `${site}/figs-vs-mandala/`;
const title = "FIGS vs Mandala Scrubs: Fit, Price & Comfort Compared | DonReady";
const description = "FIGS vs Mandala scrubs compared on fit, price, fabric, sizing and returns. Find which brand wins for long shifts.";

const choosePoints = [
  "Want a structured, polished silhouette → FIGS",
  "Want softer fabric and a friendlier price → Mandala",
  "Petite or short inseam → Mandala",
  "Premium feel and large style catalog → FIGS",
];
---
<Base>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="article" />
    <meta property="og:title" content="FIGS vs Mandala Scrubs: Which Is Better?" />
    <meta property="og:description" content="Side-by-side: fit, price, fabric, sizing and returns." />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="DonReady" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </Fragment>

  <article class="container-page py-12 md:py-16 max-w-4xl">
    <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-brand)]">Comparison · 6 min read</div>
    <h1 class="mt-2 text-3xl md:text-5xl font-bold">FIGS vs Mandala Scrubs: Which Is Better for Fit, Price, and Comfort?</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Both brands have devoted fans among healthcare workers. Here's how they stack up across the things that actually matter on a 12-hour shift.
    </p>

    <div class="surface-card mt-8 p-6 border-l-4 border-l-[var(--color-brand)]">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Quick answer</h2>
      <p class="mt-2 text-base">
        Choose <strong>FIGS</strong> for a slim, tailored silhouette and a wide style catalog. Choose <strong>Mandala</strong> for softer fabric, a more forgiving modern fit, and a lower price point.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full text-sm border rounded-xl overflow-hidden">
        <thead class="bg-[var(--color-surface)] text-left">
          <tr>
            <th class="p-3 font-semibold">Brand</th>
            <th class="p-3 font-semibold">Best for</th>
            <th class="p-3 font-semibold">Fit</th>
            <th class="p-3 font-semibold">Price</th>
            <th class="p-3 font-semibold">Fabric feel</th>
            <th class="p-3 font-semibold">Size range</th>
            <th class="p-3 font-semibold">Return policy</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-t">
            <td class="p-3 font-semibold">FIGS</td>
            <td class="p-3">Slim, tailored look</td>
            <td class="p-3">Slim through hip/thigh</td>
            <td class="p-3">$48–$68 piece</td>
            <td class="p-3">Smooth, structured</td>
            <td class="p-3">XXS–3XL (varies)</td>
            <td class="p-3 text-muted-foreground">Check current policy</td>
          </tr>
          <tr class="border-t">
            <td class="p-3 font-semibold">Mandala</td>
            <td class="p-3">Soft, modern feel</td>
            <td class="p-3">Modern, more forgiving</td>
            <td class="p-3">$36–$54 piece</td>
            <td class="p-3">Soft 4-way stretch</td>
            <td class="p-3">XXS–3XL (varies)</td>
            <td class="p-3 text-muted-foreground">Check current policy</td>
          </tr>
        </tbody>
      </table>
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Which brand fits better?</h2>
      <div class="mt-3 space-y-3 text-base text-foreground/90 leading-relaxed">
        <p>FIGS runs slim. Their core technical collection is tailored close to the body, especially through the hip and thigh. If you have an athletic build or curves, many wearers size up one notch.</p>
        <p>Mandala uses a more relaxed modern cut with a softer waistband. It tends to be more forgiving for plus-size, curvy, and broad-shouldered shapes. Petite wearers often prefer Mandala's shorter inseam options.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Which is more affordable?</h2>
      <div class="mt-3 space-y-3 text-base text-foreground/90 leading-relaxed">
        <p>Mandala typically wins on price. Tops and pants are usually $10–$15 less per piece than FIGS, and the brand runs frequent bundle promotions. FIGS rarely discounts core styles.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Which is better for long shifts?</h2>
      <div class="mt-3 space-y-3 text-base text-foreground/90 leading-relaxed">
        <p>Both perform well. FIGS holds its shape after long wear and dozens of washes. Mandala is softer out of the package and breathes a bit better in warm units. For hot environments (ER, ED, OR turnover), Mandala edges ahead.</p>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">Which should you choose?</h2>
      <ul class="mt-3 space-y-2">
        {choosePoints.map((t) => (
          <li class="flex items-start gap-2">
            <Icon path={ICONS.checkCircle} class="h-5 w-5 text-[var(--color-brand)] shrink-0 mt-0.5" />
            <span>{t}</span>
          </li>
        ))}
      </ul>
    </section>
  </article>
  <CtaBlock />
</Base>
