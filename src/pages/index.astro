---
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import Icon from "../components/Icon.astro";
import { ICONS } from "../lib/icons";

const site = "https://donready.xyz";
const title = "DonReady — Find scrubs that actually fit before you buy";
const description = "Compare scrub brands, find your best size, and stay within dress code. Free fit quiz for nurses, MAs, dental, vet techs and more.";

const benefits = [
  {
    title: "Find your best size",
    body: "Get sizing guidance based on your body type — petite, tall, plus size, athletic and more.",
    icon: ICONS.ruler,
  },
  {
    title: "Compare brands side by side",
    body: "See how FIGS, Mandala, Jaanuu, Cherokee and others stack up on fit, fabric, and price.",
    icon: ICONS.scale,
  },
  {
    title: "Check dress-code basics",
    body: "Filter recommendations to match your workplace's color, style and embroidery rules.",
    icon: ICONS.shield,
  },
];

const guides = [
  { slug: "/figs-vs-mandala", title: "FIGS vs Mandala", tag: "Comparison" },
  { slug: "/best-scrubs", title: "Best scrubs for petite nurses", tag: "Best of" },
  { slug: "/best-scrubs", title: "Best scrubs for tall nurses", tag: "Best of" },
  { slug: "/best-scrubs", title: "Best plus-size scrubs", tag: "Best of" },
  { slug: "/figs-vs-mandala", title: "Do FIGS scrubs run small?", tag: "Sizing" },
  { slug: "/best-scrubs", title: "Best affordable scrubs", tag: "Budget" },
];

const steps = [
  { n: "1", t: "Tell us your body type and preferences" },
  { n: "2", t: "Pick your role and workplace rules" },
  { n: "3", t: "Get recommended brands, sizes, and styles" },
];
---
<Base>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:site_name" content="DonReady" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        { "@type": "Organization", "@id": `${site}/#organization`, name: "DonReady", url: site },
        {
          "@type": "WebSite",
          "@id": `${site}/#website`,
          url: site,
          name: "DonReady",
          description,
          publisher: { "@id": `${site}/#organization` },
        },
      ],
    })} />
  </Fragment>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[var(--color-surface)] to-background"></div>
    <div class="container-page py-20 md:py-28 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border bg-background px-3 py-1 text-xs font-medium text-muted-foreground">
        <span class="h-2 w-2 rounded-full bg-[var(--color-brand)]"></span>
        For nurses, MAs, dental, vet techs &amp; more
      </span>
      <h1 class="mt-6 text-4xl md:text-6xl font-bold tracking-tight max-w-3xl mx-auto">
        Find scrubs that <span class="text-[var(--color-brand)]">actually fit</span> before you buy.
      </h1>
      <p class="mt-5 text-lg text-muted-foreground max-w-2xl mx-auto">
        DonReady helps healthcare workers compare scrub brands, find better sizing, and avoid dress-code mistakes.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/scrub-fit-quiz" class="btn btn-primary">
          Start Fit Quiz
          <Icon path={ICONS.arrowRight} class="h-4 w-4" />
        </a>
        <a href="/compare" class="btn btn-outline">Compare Scrub Brands</a>
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <div class="grid gap-5 md:grid-cols-3">
      {benefits.map((b) => (
        <div class="surface-card p-6">
          <div class="grid h-10 w-10 place-items-center rounded-lg bg-[var(--color-accent)] text-[var(--color-accent-foreground)]">
            <Icon path={b.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-lg font-semibold">{b.title}</h3>
          <p class="mt-2 text-sm text-muted-foreground">{b.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-16">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold">How DonReady works</h2>
      <p class="mt-3 text-muted-foreground">Three quick steps to scrubs that fit your body, budget, and shift.</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <div class="rounded-xl border p-6">
          <div class="text-sm font-semibold text-[var(--color-brand)]">Step {s.n}</div>
          <p class="mt-2 text-lg font-medium">{s.t}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-16">
    <div class="flex items-end justify-between mb-8">
      <h2 class="text-3xl font-bold">Popular guides</h2>
      <a href="/best-scrubs" class="text-sm font-medium text-[var(--color-brand)] hover:underline">View all</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => (
        <a href={g.slug} class="group surface-card p-6 hover:border-[var(--color-brand)] transition-colors block">
          <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">{g.tag}</div>
          <h3 class="mt-2 text-lg font-semibold group-hover:text-[var(--color-brand)]">{g.title}</h3>
          <div class="mt-4 inline-flex items-center text-sm font-medium text-[var(--color-brand)]">
            Read guide
            <Icon path={ICONS.arrowRight} class="ml-1 h-4 w-4" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-page py-12">
    <div class="surface-card p-8 md:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-bold">Save your scrub fit profile</h2>
      <p class="mt-2 text-muted-foreground max-w-xl mx-auto">
        Get sizing tips and brand drops in your inbox. No spam, unsubscribe anytime.
      </p>
      <form id="email-form" class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <label for="email" class="sr-only">Email</label>
        <input
          id="email"
          type="email"
          required
          placeholder="you@hospital.com"
          class="flex-1 rounded-lg border bg-background px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ring)]"
        />
        <button type="submit" class="btn btn-primary">Save profile</button>
      </form>
      <div id="email-thanks" class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-brand)] hidden">
        <Icon path={ICONS.check} class="h-4 w-4" />
        Thanks — you're on the list.
      </div>
    </div>
  </section>

  <CtaBlock />
</Base>

<script>
  const form = document.getElementById("email-form");
  const thanks = document.getElementById("email-thanks");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    form.classList.add("hidden");
    thanks?.classList.remove("hidden");
  });
</script>
