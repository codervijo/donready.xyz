---
import Base from "../layouts/Base.astro";
import CtaBlock from "../components/CtaBlock.astro";
import Icon from "../components/Icon.astro";
import { ICONS } from "../lib/icons";

const site = "https://donready.xyz";
const url = `${site}/compare/`;
const title = "Compare Scrub Brands — FIGS, Mandala, Jaanuu & more | DonReady";
const description = "Side-by-side comparisons of popular scrub brands. Find the best fit, price, and fabric for your shift.";

const comparisons = [
  { slug: "/figs-vs-mandala", title: "FIGS vs Mandala", bestFor: "Modern fit fans", price: "$80–$120", fit: "FIGS slim · Mandala modern" },
  { slug: "/figs-vs-mandala", title: "FIGS vs Jaanuu", bestFor: "Polished, tailored look", price: "$85–$130", fit: "FIGS slim · Jaanuu modern" },
  { slug: "/figs-vs-mandala", title: "FIGS vs Cherokee", bestFor: "Premium vs budget", price: "$36–$120", fit: "FIGS slim · Cherokee relaxed" },
  { slug: "/figs-vs-mandala", title: "Mandala vs Jaanuu", bestFor: "Soft, modern fabrics", price: "$70–$110", fit: "Both modern" },
  { slug: "/figs-vs-mandala", title: "Cherokee vs Grey's Anatomy", bestFor: "Affordable everyday wear", price: "$30–$70", fit: "Both relaxed" },
  { slug: "/figs-vs-mandala", title: "Best FIGS alternatives", bestFor: "Premium feel, lower price", price: "$50–$90", fit: "Modern / slim" },
];
---
<Base>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Compare Scrub Brands — DonReady" />
    <meta property="og:description" content="FIGS vs Mandala, Jaanuu, Cherokee and more. See which scrub brand fits your needs." />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="DonReady" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </Fragment>

  <section class="container-page py-12 md:py-16">
    <div class="max-w-3xl">
      <div class="text-xs font-semibold uppercase tracking-wide text-[var(--color-brand)]">Compare</div>
      <h1 class="mt-2 text-4xl md:text-5xl font-bold">Scrub brand comparisons</h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Compare popular scrub brands on fit, price, fabric, and size range. Pick the matchup that fits your shift.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {comparisons.map((c) => (
        <a href={c.slug} class="group surface-card p-6 hover:border-[var(--color-brand)] transition-colors block">
          <h2 class="text-lg font-semibold group-hover:text-[var(--color-brand)]">{c.title}</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between gap-4 border-b pb-2">
              <dt class="text-muted-foreground">Best for</dt>
              <dd class="text-right font-medium">{c.bestFor}</dd>
            </div>
            <div class="flex justify-between gap-4 border-b pb-2">
              <dt class="text-muted-foreground">Price range</dt>
              <dd class="text-right font-medium">{c.price}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted-foreground">Fit notes</dt>
              <dd class="text-right font-medium">{c.fit}</dd>
            </div>
          </dl>
          <div class="mt-5 inline-flex items-center text-sm font-medium text-[var(--color-brand)]">
            Read comparison
            <Icon path={ICONS.arrowRight} class="ml-1 h-4 w-4" />
          </div>
        </a>
      ))}
    </div>
  </section>
  <CtaBlock />
</Base>
